# Cepat UI Olshop — Environment Variables
# Salin file ini ke .env (`cp .env.example .env`) dan sesuaikan dengan konfigurasi Anda.

# ==============================================================================
# 1. API & Backend Settings
# ==============================================================================
# Base URL backend REST API (Laravel Sanctum atau backend kustom Anda)
# Local Laravel: http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# Nama Toko Online (Menimpa default di src/app.config.ts)
VITE_APP_NAME="Cepat Olshop"

# ==============================================================================
# 2. Payment Gateway Adapter (Xendit)
# ==============================================================================
# Aktifkan adapter dengan CLI: npx cepat use:adapter payment xendit
# Ambil API key publik dari dashboard Xendit (Settings > API Keys)
VITE_XENDIT_PUBLIC_KEY=xnd_public_development_example1234567890
VITE_XENDIT_IS_SANDBOX=true

# ==============================================================================
# 3. Shipping Adapter (RajaOngkir)
# ==============================================================================
# Aktifkan adapter dengan CLI: npx cepat use:adapter shipping rajaongkir
# Dapatkan API Key di https://rajaongkir.com/dokumentasi
VITE_RAJAONGKIR_API_KEY=your_rajaongkir_api_key_here
VITE_RAJAONGKIR_ORIGIN_CITY_ID=23 # 23 = Kota Bandung

# ==============================================================================
# 4. Storage Adapter (Cloudinary CDN)
# ==============================================================================
# Aktifkan adapter dengan CLI: npx cepat use:adapter storage cloudinary
# Dapatkan kredensial di https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
